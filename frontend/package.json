{
  "name": "guitar-chords-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-ort": "node scripts/copy-ort.mjs",
    "dev": "npm run copy-ort && vite",
    "build": "npm run copy-ort && tsc --noEmit && vite build && node scripts/engine-manifest.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/lib/engine/*.test.ts",
    "check-model": "node --experimental-strip-types tools/ci-model-check.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "@capacitor/cli": "^6.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
